# ======================================
# Railway.app Environment Variables
# ======================================
# Copy these to Railway Dashboard for each service

# ======================================
# COMMON (All Services)
# ======================================
# JWT Secret (same for all services)
JWT_SECRET=yourProductionSecretMustBeAtLeast32CharactersLongForHS256!

# Timezone
TZ=Asia/Kolkata

# ======================================
# DATABASE (From Railway PostgreSQL)
# ======================================
# Railway provides these automatically as:
# DATABASE_URL, PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
# But we need to format them for Spring Boot

DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}
DB_USER=${PGUSER}
DB_PASSWORD=${PGPASSWORD}

# ======================================
# REDIS (From Railway Redis)
# ======================================
# Railway provides: REDIS_URL
# We need host and port separately

REDIS_HOST=${REDIS_PRIVATE_URL} # Railway internal URL
REDIS_PORT=6379
REDIS_PASSWORD= # Leave empty if no password

# ======================================
# KAFKA (From CloudKarafka - FREE)
# ======================================
# Get from https://www.cloudkarafka.com
# Plan: Developer Duck (FREE)
KAFKA_SERVERS=ark-01.srvs.cloudkarafka.com:9094,ark-02.srvs.cloudkarafka.com:9094,ark-03.srvs.cloudkarafka.com:9094
KAFKA_USERNAME=your-cloudkarafka-username
KAFKA_PASSWORD=your-cloudkarafka-password
KAFKA_TOPIC_PREFIX=xyz12345-
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SECURITY_PROTOCOL=SASL_SSL

# ======================================
# SERVICE URLS (Railway Internal)
# ======================================
# Use Railway's internal networking: servicename.railway.internal:port
# Or use Railway's public URLs

# For API Gateway
USER_SERVICE_URL=http://user-service.railway.internal:8081
PRODUCT_SERVICE_URL=http://product-service.railway.internal:8082
ORDER_SERVICE_URL=http://order-service.railway.internal:8083
NOTIFICATION_SERVICE_URL=http://notification-service.railway.internal:8084

# ======================================
# API GATEWAY SPECIFIC
# ======================================
SERVER_PORT=8080

# ======================================
# USER SERVICE SPECIFIC
# ======================================
# (Uses common DB, JWT configs above)

# ======================================
# PRODUCT SERVICE SPECIFIC
# ======================================
# (Uses common DB configs above)

# ======================================
# ORDER SERVICE SPECIFIC
# ======================================
# (Uses common DB, Kafka configs above)
PRODUCT_SERVICE_URL=http://product-service.railway.internal:8082

# ======================================
# NOTIFICATION SERVICE SPECIFIC
# ======================================
# (Uses common DB, Kafka configs above)

# ======================================
# LOGGING
# ======================================
LOG_LEVEL=INFO

# ======================================
# NOTES:
# ======================================
# 1. Railway automatically injects: DATABASE_URL, PGHOST, PGPORT, etc.
# 2. Use ${VARIABLE} syntax to reference Railway's auto-injected vars
# 3. Internal URLs: servicename.railway.internal:port (faster, no public internet)
# 4. Public URLs: provided by Railway after deployment
# 5. Upstash Kafka: Sign up at https://upstash.com for free tier
